{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Maven: 编译",
      "type": "shell",
      "command": "mvn",
      "args": ["-B", "-DskipTests", "compile"],
      "group": "build",
      "problemMatcher": ["$java"]
    },
    {
      "label": "Maven: 跑测试",
      "type": "shell",
      "command": "mvn",
      "args": ["-B", "test"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$java"]
    },
    {
      "label": "Maven: 启动服务",
      "type": "shell",
      "command": "mvn",
      "args": ["-B", "spring-boot:run"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Maven: 打包 jar",
      "type": "shell",
      "command": "mvn",
      "args": ["-B", "clean", "package"],
      "group": "build",
      "problemMatcher": ["$java"]
    },
    {
      "label": "Tools: 数值与物理全套校验",
      "type": "shell",
      "command": "node tools/design-levels.mjs; node tools/calibrate.mjs; node tools/physics-selftest.mjs; node tools/syntax-check.mjs",
      "problemMatcher": []
    },
    {
      "label": "Tools: 接口契约验收（需先启动服务）",
      "type": "shell",
      "command": "node tools/api-check.mjs",
      "problemMatcher": []
    }
  ]
}
